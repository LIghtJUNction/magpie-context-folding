{
  "name": "magpie-context-folding",
  "version": "0.2.0",
  "description": "Agent-directed, reversible context folding with a conservative cache cost gate for Magpie",
  "type": "module",
  "main": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "magpie": { "hooks": "./src/context.hooks.ts" },
  "bin": { "magpie-context-folding": "./src/cli.ts" },
  "files": ["src", "README.md", "docs", "LICENSE"],
  "repository": { "type": "git", "url": "git+https://github.com/LIghtJUNction/magpie-context-folding.git" },
  "homepage": "https://github.com/LIghtJUNction/magpie-context-folding#readme",
  "bugs": { "url": "https://github.com/LIghtJUNction/magpie-context-folding/issues" },
  "keywords": ["magpie-plugin", "magpie", "context", "folding", "mcp"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts",
    "test:host": "python3 scripts/host-smoke.py",
    "stats": "bun src/cli.ts stats",
    "bench:folding": "bun scripts/folding-benchmark.ts",
    "bench:economics": "python3 scripts/economic-analysis.py",
    "bench:inference": "python3 scripts/inference-benchmark.py",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": { "bun": ">=1.2.0", "node": ">=22" },
  "license": "MIT",
  "dependencies": { "zod": "^4.1.0" },
  "devDependencies": { "@types/bun": "^1.3.0", "@types/node": "^24.0.0", "typescript": "^5.9.0" }
}
