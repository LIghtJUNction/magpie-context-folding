{
  "name": "magpie-context-folding",
  "version": "0.5.2",
  "description": "Automatic system guidance and CLI-only recovery for reversible Magpie context folding",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "magpie": {
    "hooks": "./src/context.hooks.ts",
    "icon": "data:image/png;base64,"
  },
  "bin": {
    "magpie-context-folding": "dist/cli.js"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LIghtJUNction/magpie-context-folding.git"
  },
  "homepage": "https://github.com/LIghtJUNction/magpie-context-folding#readme",
  "bugs": {
    "url": "https://github.com/LIghtJUNction/magpie-context-folding/issues"
  },
  "keywords": [
    "magpie-plugin",
    "magpie",
    "context",
    "folding",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate test/*.test.ts",
    "test:host": "python3 scripts/host-smoke.py",
    "test:host:installed": "python3 -I scripts/installed-package-smoke.py",
    "bench:self": "python3 -I scripts/self-benchmark.py",
    "bench:iterate": "uv run --project benchmarks/harbor --frozen python scripts/self-iterate.py",
    "bench:quality": "uv run --project benchmarks/harbor --frozen python scripts/cost-quality-benchmark.py",
    "bench:tree": "bun scripts/tree-benchmark.ts",
    "bench:fold-strategies": "bun run scripts/fold-strategy-benchmark.ts",
    "bench:hook-projection": "bun scripts/hook-projection-benchmark.ts",
    "test:controller": "python3 -I scripts/test_self_iterate.py",
    "stats": "bun src/cli.ts stats",
    "check": "npm run typecheck && npm test && npm run build",
    "bench:harbor": "uv run --project benchmarks/harbor --frozen python benchmarks/harbor/run.py",
    "test:harbor": "uv run --project benchmarks/harbor --frozen python benchmarks/harbor/run.py test"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
