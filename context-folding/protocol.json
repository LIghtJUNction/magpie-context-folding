{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Folding RPC v3",
  "description": "Local UTF-8 JSON Lines transport: one ordered request and result/error response per line. Run ctxf rpc --state /absolute/private/archive.sqlite. CLI and SDKs share the Python engine. Originals are immutable ordinary files; SQLite tracks indices and legacy recovery. No MCP service, network listener or model calls. API calls require scope; ctxf defaults its command scope to default. Offsets count Unicode code points.",
  "type": "object",
  "required": [
    "action",
    "scope"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "fold",
        "fold-messages",
        "put",
        "list",
        "read",
        "render",
        "restore",
        "resolve",
        "paste",
        "status",
        "gc",
        "roots",
        "pin",
        "skills",
        "annotate",
        "read-source"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "description": "Required for fold. Without range, folds closed explicit annotations that save UTF-8 bytes. With range, folds precisely the selected [start,end) Unicode code points, even when the pointer is longer."
    },
    "language": {
      "type": "string"
    },
    "commentStyles": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "start"
        ],
        "properties": {
          "start": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "end": {
            "type": "string",
            "maxLength": 64
          }
        },
        "additionalProperties": false
      }
    },
    "keep": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expand": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expandMode": {
      "type": "string",
      "enum": [
        "single",
        "recursive"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object"
      }
    },
    "id": {
      "type": "string"
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "value": {},
    "query": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "body": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "sort": {
      "type": "string",
      "enum": [
        "chronological",
        "size",
        "id",
        "version"
      ]
    },
    "order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "name": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean"
    },
    "occurrence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "requestCycle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "peek": {
      "type": "boolean"
    },
    "range": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "object",
              "required": [
                "message"
              ],
              "properties": {
                "message": {
                  "type": "integer",
                  "minimum": 0
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                }
              },
              "additionalProperties": false
            },
            "end": {
              "type": "object",
              "required": [
                "message"
              ],
              "properties": {
                "message": {
                  "type": "integer",
                  "minimum": 0
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Half-open selection. fold uses code-point offsets; fold-messages uses zero-based message positions and optional code-point offsets. End message may equal the message count. Structured/tool-bearing messages are atomic and complete tool pairs must remain together."
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object"
      },
      "description": "Conversation messages with role and content. Boundary text slices retain their original role; the selected span becomes one user archive notice."
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "fold"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "fold-messages"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "messages",
          "range"
        ]
      }
    }
  ],
  "$defs": {
    "foldReference": {
      "type": "object",
      "required": [
        "id",
        "label",
        "sha256",
        "reference",
        "archiveId",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Complete body SHA-256; usable with read in the same state and scope."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference": {
          "type": "string",
          "pattern": "^\\[\\[cf:v3:[a-f0-9]{12,64} path=\".*\"\\]\\]$",
          "description": "Path is a JSON-quoted absolute filename. Legacy v1/v2 references remain resolvable. resolve looks up this scope/hash, never opens the supplied path."
        },
        "archiveId": {
          "type": "string",
          "minLength": 1,
          "description": "The backing archive entry identifier."
        },
        "path": {
          "type": "string",
          "description": "Absolute UTF-8 original file, or readable transcript for fold-messages."
        },
        "messagesPath": {
          "type": "string",
          "description": "fold-messages JSONL manifest with original roles, source message indices, and exact selected content slices."
        }
      },
      "additionalProperties": true
    },
    "foldResult": {
      "type": "object",
      "required": [
        "scope",
        "text",
        "references"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "description": "Complete projected text, without pagination or an added trailing newline."
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foldReference"
          },
          "description": "Only bodies folded by this call; existing literal references are left intact."
        }
      },
      "additionalProperties": true
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "result": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "messageFoldResult": {
      "type": "object",
      "required": [
        "scope",
        "messages",
        "references"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foldReference"
          }
        }
      }
    }
  },
  "examples": [
    {
      "action": "fold",
      "scope": "example",
      "text": "before 中文🙂 after",
      "range": {
        "start": 7,
        "end": 10
      }
    },
    {
      "action": "fold-messages",
      "scope": "example",
      "messages": [
        {
          "role": "user",
          "content": "initial request"
        },
        {
          "role": "assistant",
          "content": "completed work"
        },
        {
          "role": "user",
          "content": "next request"
        }
      ],
      "range": {
        "start": {
          "message": 0
        },
        "end": {
          "message": 2
        }
      }
    },
    {
      "action": "fold",
      "scope": "example",
      "text": "<!-- @context-fold begin result -->\nCompleted evidence that can be recovered through its content hash.\n<!-- @context-fold end result -->"
    },
    {
      "action": "fold",
      "scope": "example",
      "text": ""
    },
    {
      "action": "read-source",
      "scope": "example",
      "text": "# @context-fold begin result\ncompleted evidence\n# @context-fold end result",
      "language": "python",
      "occurrence": "read-1",
      "requestCycle": 0
    },
    {
      "action": "read-source",
      "scope": "example",
      "id": "ENTRY_ID",
      "occurrence": "read-1",
      "requestCycle": 1
    },
    {
      "action": "read",
      "scope": "example",
      "id": "CONTENT_HASH_PREFIX"
    },
    {
      "action": "resolve",
      "scope": "example",
      "value": "[[cf:v2:CONTENT_HASH_PREFIX]]"
    }
  ]
}
