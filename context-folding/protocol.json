{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Folding RPC v2",
  "description": "Local UTF-8 JSON Lines transport: one ordered request and result/error response per line. Run ctxf rpc --state /absolute/private/archive.sqlite. CLI and SDKs share the Python engine and SQLite archive. State is selected outside the request. API calls require scope even though the CLI defaults it to default. Core validation defines action-specific constraints. No network listener or model calls.",
  "type": "object",
  "required": [
    "action",
    "scope"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "fold",
        "put",
        "list",
        "read",
        "render",
        "restore",
        "resolve",
        "paste",
        "status",
        "gc",
        "roots",
        "pin",
        "skills",
        "annotate",
        "read-source"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "description": "Required for fold, including the empty string. Fold returns the complete immediate projection of explicitly marked text; read-source independently retains its host-cycle delay."
    },
    "language": {
      "type": "string"
    },
    "commentStyles": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "start"
        ],
        "properties": {
          "start": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "end": {
            "type": "string",
            "maxLength": 64
          }
        },
        "additionalProperties": false
      }
    },
    "keep": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expand": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expandMode": {
      "type": "string",
      "enum": [
        "single",
        "recursive"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object"
      }
    },
    "id": {
      "type": "string"
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "value": {},
    "query": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "body": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "sort": {
      "type": "string",
      "enum": [
        "chronological",
        "size",
        "id",
        "version"
      ]
    },
    "order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "name": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean"
    },
    "occurrence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "requestCycle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "peek": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": { "const": "fold" }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["text"]
      }
    }
  ],
  "$defs": {
    "foldReference": {
      "type": "object",
      "required": ["id", "label", "sha256", "reference", "archiveId"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Complete body SHA-256; usable with read in the same state and scope."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference": {
          "type": "string",
          "pattern": "^\\[\\[cf:v2:[a-f0-9]{12,64}\\]\\]$"
        },
        "archiveId": {
          "type": "string",
          "minLength": 1,
          "description": "The backing archive entry identifier."
        }
      },
      "additionalProperties": true
    },
    "foldResult": {
      "type": "object",
      "required": ["scope", "text", "references"],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "description": "Complete projected text, without pagination or an added trailing newline."
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/foldReference" },
          "description": "Only bodies folded by this call; existing literal references are left intact."
        }
      },
      "additionalProperties": true
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "result": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "examples": [
    {
      "action": "fold",
      "scope": "example",
      "text": "<!-- @context-fold begin result -->\nCompleted evidence that can be recovered through its content hash.\n<!-- @context-fold end result -->"
    },
    {
      "action": "fold",
      "scope": "example",
      "text": ""
    },
    {
      "action": "read-source",
      "scope": "example",
      "text": "# @context-fold begin result\ncompleted evidence\n# @context-fold end result",
      "language": "python",
      "occurrence": "read-1",
      "requestCycle": 0
    },
    {
      "action": "read-source",
      "scope": "example",
      "id": "ENTRY_ID",
      "occurrence": "read-1",
      "requestCycle": 1
    },
    {
      "action": "read",
      "scope": "example",
      "id": "CONTENT_HASH_PREFIX"
    },
    {
      "action": "resolve",
      "scope": "example",
      "value": "[[cf:v2:CONTENT_HASH_PREFIX]]"
    }
  ]
}
