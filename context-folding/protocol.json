{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Folding RPC v2",
  "description": "Local ordered UTF-8 JSON Lines RPC over the shared Python archive. Run ctxf rpc. Read/list/grep/meta return bounded node views without changing fold/keep state. Compatibility export, recovery and lifecycle actions remain available. State is selected outside requests and API scope is required. No network listener or model calls. Core validation remains authoritative.",
  "type": "object",
  "required": [
    "action",
    "scope"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "fold",
        "put",
        "list",
        "grep",
        "meta",
        "read",
        "render",
        "restore",
        "resolve",
        "paste",
        "status",
        "gc",
        "roots",
        "pin",
        "skills",
        "annotate",
        "read-source"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "description": "Required for fold, including the empty string. Fold returns the complete immediate projection of explicitly marked text; read-source independently retains its host-cycle delay."
    },
    "language": {
      "type": "string"
    },
    "commentStyles": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "start"
        ],
        "properties": {
          "start": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "end": {
            "type": "string",
            "maxLength": 64
          }
        },
        "additionalProperties": false
      }
    },
    "keep": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "deprecated": true,
      "description": "Compatibility field; not part of the ordinary query workflow. Queries do not unfold history or set keep."
    },
    "expand": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "deprecated": true,
      "description": "Compatibility field; not part of the ordinary query workflow. Queries do not unfold history or set keep."
    },
    "expandMode": {
      "type": "string",
      "enum": [
        "single",
        "recursive"
      ],
      "deprecated": true,
      "description": "Compatibility field; not part of the ordinary query workflow. Queries do not unfold history or set keep."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object"
      }
    },
    "id": {
      "type": "string",
      "description": "Archive ID or unambiguous content-hash prefix in the selected scope."
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "deprecated": true,
      "description": "Compatibility field; not part of the ordinary query workflow. Queries do not unfold history or set keep."
    },
    "value": {},
    "query": {
      "type": "string",
      "description": "Literal search text for grep; matching happens inside the archive."
    },
    "path": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "deprecated": true,
      "description": "Compatibility field; not part of the ordinary query workflow. Queries do not unfold history or set keep."
    },
    "config": {
      "type": "object"
    },
    "body": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "description": "Read characters (default 1200, max 24000), or list/grep/meta items (default 10, max 100)."
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Result index for list/grep/meta; Unicode code-point offset in a read node view."
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64,
      "default": 1,
      "description": "List traversal depth; descendant IDs remain independently queryable."
    },
    "sort": {
      "type": "string",
      "enum": [
        "chronological",
        "size",
        "id",
        "version"
      ]
    },
    "order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "name": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean"
    },
    "occurrence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "requestCycle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "peek": {
      "type": "boolean",
      "deprecated": true,
      "description": "Compatibility field; not part of the ordinary query workflow. Queries do not unfold history or set keep."
    },
    "startLine": {
      "type": "integer",
      "minimum": 1,
      "description": "Inclusive 1-based node-view start line; incompatible with offset."
    },
    "endLine": {
      "type": "integer",
      "minimum": 1,
      "description": "Inclusive node-view end line; incompatible with offset."
    },
    "recursive": {
      "type": "boolean",
      "description": "Traverse descendant node views internally, with visited-node deduplication. Grep defaults to true; list defaults to false."
    },
    "context": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0,
      "description": "Neighboring grep lines; each returned snippet is bounded."
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "fold"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "read",
              "meta"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "grep"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "minLength": 1
          },
          "recursive": {
            "default": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "list",
              "grep",
              "meta"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "limit": {
            "maximum": 100
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "read"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "limit": {
            "maximum": 24000
          }
        },
        "not": {
          "allOf": [
            {
              "required": [
                "offset"
              ]
            },
            {
              "anyOf": [
                {
                  "required": [
                    "startLine"
                  ]
                },
                {
                  "required": [
                    "endLine"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "list"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "recursive": {
            "default": false
          }
        }
      }
    }
  ],
  "$defs": {
    "foldReference": {
      "type": "object",
      "required": [
        "id",
        "label",
        "sha256",
        "reference",
        "archiveId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Complete original-body SHA-256; accepted by read/grep/meta in the same archive and scope."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference": {
          "type": "string",
          "pattern": "^\\[\\[cf:v2:[a-f0-9]{12,64}\\]\\]$"
        },
        "archiveId": {
          "type": "string",
          "minLength": 1,
          "description": "The backing archive entry identifier."
        }
      },
      "additionalProperties": true
    },
    "foldResult": {
      "type": "object",
      "required": [
        "scope",
        "text",
        "references"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "description": "Complete projected text, without pagination or an added trailing newline."
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foldReference"
          },
          "description": "Top-level references in this folded view. Discover nested children through list/meta; existing reference literals are not new folds."
        }
      },
      "additionalProperties": true
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "result": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "nodeMetadata": {
      "type": "object",
      "required": [
        "id",
        "childCount"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference": {
          "type": "string"
        },
        "chars": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "childCount": {
          "type": "integer",
          "minimum": 0
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "listResult": {
      "type": "object",
      "required": [
        "entries",
        "nextOffset"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeMetadata"
          }
        },
        "nextOffset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "metaResult": {
      "type": "object",
      "required": [
        "id",
        "sha256",
        "chars",
        "bytes",
        "childCount",
        "children",
        "nextOffset"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "chars": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "childCount": {
          "type": "integer",
          "minimum": 0
        },
        "children": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string"
          }
        },
        "nextOffset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "readResult": {
      "type": "object",
      "required": [
        "id",
        "text",
        "offset",
        "nextOffset",
        "totalChars",
        "sha256",
        "viewSha256",
        "childCount"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Bounded node view with direct child references retained."
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "nextOffset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "totalChars": {
          "type": "integer",
          "minimum": 0
        },
        "totalLines": {
          "type": "integer",
          "minimum": 0
        },
        "startLine": {
          "type": "integer",
          "minimum": 0
        },
        "endLine": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of exact original body bytes."
        },
        "viewSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the complete node view, before pagination."
        },
        "childCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "grepLine": {
      "type": "object",
      "required": [
        "line",
        "text"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "maxLength": 160
        },
        "textOffset": {
          "type": "integer",
          "minimum": 0,
          "description": "Start of this snippet within the view line, in Unicode code points."
        }
      },
      "additionalProperties": true
    },
    "grepResult": {
      "type": "object",
      "required": [
        "matches",
        "nextOffset"
      ],
      "properties": {
        "matches": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/grepLine"
              }
            ],
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "context": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/grepLine"
                }
              }
            }
          }
        },
        "nextOffset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "action": "fold",
      "scope": "task",
      "text": "<!-- @context-fold begin parent -->\nSummary.\n<!-- @context-fold begin child -->\nDetailed evidence long enough to replace with a reference.\n<!-- @context-fold end child -->\n<!-- @context-fold end parent -->"
    },
    {
      "action": "fold",
      "scope": "task",
      "text": ""
    },
    {
      "action": "list",
      "scope": "task",
      "id": "ACTUAL_HASH",
      "depth": 2,
      "limit": 5
    },
    {
      "action": "meta",
      "scope": "task",
      "id": "ACTUAL_HASH"
    },
    {
      "action": "grep",
      "scope": "task",
      "id": "ACTUAL_HASH",
      "query": "timeout",
      "limit": 3
    },
    {
      "action": "read",
      "scope": "task",
      "id": "ACTUAL_HASH",
      "startLine": 1,
      "endLine": 4,
      "limit": 240
    },
    {
      "action": "status",
      "scope": "task"
    }
  ]
}
